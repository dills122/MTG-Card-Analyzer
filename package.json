{
    "name": "mtg-card-analyzer",
    "version": "0.2.0",
    "private": true,
    "description": "Local-first CLI for identifying Magic: The Gathering cards from images",
    "type": "module",
    "main": "index.mjs",
    "bin": {
        "mtg-card-analyzer": "./index.mjs"
    },
    "files": [
        "index.mjs",
        "eng.traineddata",
        "mtg.config.example.json",
        "secure.config.template.cjs",
        "Readme.md",
        "LICENSE",
        "docs/cli-reference.md",
        "docs/configuration.md",
        "src/config/",
        "src/console/",
        "src/db-local/",
        "src/diagnostics/",
        "src/export-processor/",
        "src/file-io.mjs",
        "src/fuzzy-matching/",
        "src/image-analysis/",
        "src/image-hashing/",
        "src/image-processing/",
        "src/logger/",
        "src/matcher/",
        "src/migrate/",
        "src/models/",
        "src/processor/",
        "src/rds/",
        "src/scryfall-api/api.config.mjs",
        "src/scryfall-api/get-card-name.mjs",
        "src/scryfall-api/http-client.mjs",
        "src/scryfall-api/index.mjs",
        "src/scryfall-api/search-name.mjs",
        "src/storage/",
        "src/util.mjs"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dills122/MTG-Card-Analyzer.git"
    },
    "homepage": "https://github.com/dills122/MTG-Card-Analyzer#readme",
    "bugs": {
        "url": "https://github.com/dills122/MTG-Card-Analyzer/issues"
    },
    "packageManager": "pnpm@10.13.1",
    "engines": {
        "node": ">=20.0.0",
        "pnpm": ">=8.0.0"
    },
    "scripts": {
        "ai:check": "node scripts/setup-ai-context.mjs --check",
        "ai:setup": "node scripts/setup-ai-context.mjs",
        "site:dev": "astro dev",
        "site:build": "astro build",
        "site:preview": "astro preview",
        "test": "mocha \"./test/**/*.spec.mjs\"",
        "test:package": "node scripts/package-smoke.mjs",
        "test:regression": "node scripts/run-regression.mjs",
        "regression:compare": "node scripts/compare-ocr-models.mjs",
        "training:data:check": "node scripts/validate-ocr-training-data.mjs",
        "training:review:promote": "node scripts/promote-ocr-training-review.mjs",
        "training:review:stage": "node scripts/stage-ocr-training-review.mjs",
        "training:image:build": "docker build --file training/ocr/Dockerfile --tag mtg-card-analyzer/tesstrain:405346a3a67d training/ocr",
        "training:run": "node scripts/train-ocr-model.mjs",
        "fixtures:import": "node scripts/import-scryfall-fixtures.mjs",
        "regression": "node scripts/run-regression.mjs --no-fail-on-regression",
        "coverage": "c8 pnpm test",
        "coverage:check": "c8 --check-coverage pnpm test",
        "lint": "eslint . --ext js,mjs",
        "lint:fix": "pnpm lint --fix",
        "lint-staged": "lint-staged",
        "prettier:check": "prettier --check \"**/*.{js,mjs,ts,tsx,md,json,yml,yaml}\"",
        "prettier:write": "prettier --write \"**/*.{js,mjs,ts,tsx,md,json,yml,yaml}\"",
        "format": "pnpm prettier:write",
        "typecheck": "tsc -p tsconfig.checked.json --noEmit",
        "check:fast": "pnpm lint && pnpm prettier:check && pnpm typecheck",
        "check": "pnpm check:fast && pnpm test",
        "setup-db": "node src/data/scripts/setup-db.cjs",
        "setup": "node scripts/setup.mjs",
        "verify": "node scripts/verify-env.mjs",
        "docker:up": "docker compose up -d",
        "docker:down": "docker compose down",
        "docker:logs": "docker compose logs -f mysql"
    },
    "keywords": [
        "mtg",
        "ocr",
        "collector"
    ],
    "author": {
        "name": "Dylan Steele",
        "email": "dylansteele57@gmail.com"
    },
    "license": "MIT",
    "c8": {
        "all": true,
        "src": "src",
        "include": [
            "src/**/*.mjs",
            "index.mjs"
        ],
        "exclude": [
            "test-images/**",
            "src/data/**",
            "**/*.spec.mjs",
            "test/**"
        ],
        "reporter": [
            "text",
            "html",
            "lcov"
        ],
        "reports-dir": "coverage",
        "lines": 85,
        "statements": 85,
        "functions": 85,
        "branches": 70
    },
    "dependencies": {
        "@dills1220/nedb": "^1.9.1",
        "clean-text-utils": "^1.3.0",
        "commander": "^15.0.0",
        "fuzzyset.js": "1.0.7",
        "image-hash": "^7.0.1",
        "jimp": "1.6.1",
        "joi": "^18.2.3",
        "lodash": "^4.18.1",
        "mysql2": "^3.16.0",
        "string-similarity": "^4.0.4",
        "tesseract.js": "3.0.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@types/node": "^25.9.1",
        "astro": "^7.1.1",
        "c8": "^12.0.0",
        "chai": "^6.2.2",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.7.0",
        "lefthook": "^2.1.10",
        "lint-staged": "^17.3.0",
        "mocha": "^11.8.0",
        "prettier": "^3.9.4",
        "sinon": "^21.1.2",
        "typescript": "^5.9.3"
    },
    "pnpm": {
        "overrides": {
            "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
            "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
            "diff@>=6.0.0 <8.0.3": "8.0.4",
            "flatted@<3.4.2": "3.4.2",
            "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
            "serialize-javascript@<=7.0.4": "7.0.5"
        }
    }
}
