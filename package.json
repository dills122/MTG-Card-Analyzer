{
    "name": "mtg-card-analyzer",
    "version": "0.2.0",
    "description": "a mtg ocr app for documenting a collection",
    "main": "index.js",
    "scripts": {
        "test": "mocha \"./test/**/*.spec.mjs\"",
        "lint": "eslint . --ext js,mjs",
        "prettier:check": "prettier --check \"**/*.{js,mjs,ts,tsx,md,json,yml,yaml}\"",
        "prettier:write": "prettier --write \"**/*.{js,mjs,ts,tsx,md,json,yml,yaml}\"",
        "typecheck": "tsc --noEmit",
        "setup-db": "node src/data/scripts/setup-db.js",
        "prepare": "lefthook install"
    },
    "keywords": [
        "mtg",
        "ocr",
        "collector"
    ],
    "author": "Dylan Steele",
    "license": "MIT",
    "dependencies": {
        "@dills1220/nedb": "^1.8.4",
        "async": "^3.2.6",
        "bunyan": "^1.8.15",
        "clean-text-utils": "^1.1.17",
        "fuzzyset.js": "1.0.7",
        "image-hash": "^5.3.2",
        "image-size": "^1.2.1",
        "image-to-base64": "^2.2.0",
        "jimp": "^0.22.12",
        "joi": "^17.13.3",
        "lodash": "^4.17.21",
        "meow": "^7.1.1",
        "mysql2": "^3.16.0",
        "request": "^2.88.0",
        "request-promise-native": "^1.0.7",
        "rimraf": "^6.1.2",
        "string-similarity": "^4.0.4",
        "tesseract.js": "^3.0.3",
        "tmp": "^0.2.5"
    },
    "devDependencies": {
        "@types/node": "^16.9.1",
        "chai": "^6.2.2",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^9.1.2",
        "lefthook": "^1.13.6",
        "mocha": "^11.7.5",
        "prettier": "^3.7.4",
        "proxyquire": "^2.1.3",
        "sinon": "^21.0.1",
        "typescript": "^5.9.3"
    }
}
